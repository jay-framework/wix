<html>
  <head>
    <title>Request received — Jay Wix Forms testbed</title>
    <meta
      name="description"
      content="Confirmation page reached through a server-side submit hook's redirectTo (wix-forms DL#40)."
    />
    <script type="application/jay-data" contract="./page.jay-contract"></script>
    <link rel="stylesheet" href="../../../styles/theme.css" />
    <style>
      .confirmed {
        max-width: 32rem;
        margin: 3rem auto;
        padding: 1.5rem;
        border: 1px solid #2ecc71;
        border-radius: 0.5rem;
      }
    </style>
  </head>
  <body>
    <main class="confirmed" role="status">
      <h1>Request received</h1>
      <p>Your reference: <strong>{reference}</strong></p>
      <p>Submitted as: <strong>{callerType}</strong></p>
      <p><a href="/contact">Back to the contact form</a></p>
    </main>
  </body>
</html>
