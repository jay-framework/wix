<html>
<head>
  <script type="application/jay-headless" plugin="@jay-framework/wix-stores-v1" contract="category-list" key="catalog"></script>
  <script type="application/jay-headless" plugin="@jay-framework/wix-cart" contract="cart-indicator" key="cart"></script>
  <script type="application/jay-headless" plugin="@jay-framework/gemini-agent-plugin" contract="gemini-chat" key="ai"></script>
  <script type="application/jay-data">data:</script>
  <title>The Whisky Exchange - Fine Whiskies &amp; Spirits</title>
  <meta name="description" content="Explore our curated collection of the world's finest whiskies, from single malts to rare vintages." />
  <link rel="canonical" href="/" />
  <link rel="stylesheet" href="../styles/theme.css" />
  <style>
    .home-categories { padding: 48px 0; }
    .home-search-cta {
      background: var(--bg-secondary);
      padding: 48px;
      text-align: center;
      border-radius: var(--radius-md);
      margin: 48px 0;
    }
    .category-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      height: 100%;
    }
    .category-card-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #3a2a1a 0%, #5c3d2e 100%);
      color: rgba(255, 255, 255, 0.7);
      font-family: var(--font-serif);
      font-size: 1rem;
      text-align: center;
      padding: 16px;
    }
    .home-search-cta h2 {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      margin-bottom: 8px;
    }
    .home-search-cta p {
      color: var(--text-secondary);
      margin-bottom: 24px;
    }
  </style>
</head>
<body>
<div>
  <!-- Site Header -->
  <header class="site-header">
    <div class="header-top">
      <a href="/" class="site-logo">The Whisky<span>Exchange</span></a>
      <div class="header-actions">
        <a ref="cart.cartLink" href="/cart" class="cart-indicator">
          Cart
          <span if="cart.hasItems" class="cart-badge">{cart.itemCount}</span>
        </a>
      </div>
    </div>
  </header>
  <nav class="header-nav">
    <ul>
      <li><a href="/" class="active">Home</a></li>
      <li><a href="/products">All Whisky</a></li>
      <li><a href="/cart">Basket</a></li>
    </ul>
  </nav>

  <main>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">The Whisky Exchange</h1>
      <p class="hero-subtitle">Explore our curated collection of the world's finest whiskies, from single malts to rare vintages.</p>
      <a href="/products" class="btn btn-primary btn-lg">Browse All Whisky</a>
    </div>
  </section>

  <!-- Categories -->
  <section class="home-categories">
    <div class="container">
      <h2 class="section-title">Shop by Category</h2>
      <div if="catalog.hasCategories" class="category-grid">
        <div forEach="catalog.categories" trackBy="_id" class="category-card">
          <a href="/categories/{slug}" ref="catalog.categories.categoryLink" class="category-card-link">
            <img if="hasImage" src="{imageUrl}/v1/fill/w_400,h_300/file.webp" alt="{name}" width="400" height="300" loading="lazy" fetchpriority="high" />
            <div if="!hasImage" class="category-card-placeholder">
              <span>{name}</span>
            </div>
            <div class="category-card-overlay">
              <div class="category-card-name">{name}</div>
              <div class="category-card-count">{productCount} products</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Search CTA -->
  <div class="container">
    <div class="home-search-cta">
      <h2>Looking for something specific?</h2>
      <p>Search our full catalog of over 4,000 whiskies</p>
      <a href="/products" class="btn btn-outline">Search Whiskies</a>
    </div>
  </div>

  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-content">
      <div>
        <div class="footer-brand">The Whisky Exchange</div>
        <p class="footer-text">Your destination for exceptional whiskies from around the world.</p>
      </div>
      <div>
        <div class="footer-heading">Shop</div>
        <ul class="footer-links">
          <li><a href="/products">All Whisky</a></li>
          <li><a href="/cart">Basket</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-heading">Help</div>
        <ul class="footer-links">
          <li><a href="#">Delivery</a></li>
          <li><a href="#">Returns</a></li>
          <li><a href="#">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-heading">About</div>
        <ul class="footer-links">
          <li><a href="#">Our Story</a></li>
          <li><a href="#">Blog</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; 2026 The Whisky Exchange. All rights reserved.
    </div>
  </footer>

  <!-- Chat Widget -->
  <div class="chat-widget">
    <div class="chat-panel">
      <!-- Expanded history -->
      <div if="ai.isExpanded" class="chat-history">
        <div class="chat-history-header">
          <span class="chat-history-title">Chat History</span>
          <button ref="ai.toggleExpand" class="chat-history-close">&times;</button>
        </div>
        <div class="chat-messages-scroll">
          <div if="!ai.hasMessages" class="chat-messages-empty">
            Ask me anything about our whisky collection, recommendations, or help navigating the store.
          </div>
          <div if="ai.hasMessages">
            <div forEach="ai.messages" trackBy="index">
              <div if="role===user" class="chat-message chat-message-user">{content}</div>
              <div if="role===assistant" class="chat-message chat-message-assistant">{content}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Last message preview (compact mode) -->
      <div if="!ai.isExpanded&&ai.hasMessages" class="chat-preview">
        <button ref="ai.toggleExpand" class="chat-expand-btn">View full history ↑</button>
        <div if="!ai.isLoading" class="chat-preview-messages">
          <div class="chat-message chat-message-user">{ai.lastUserMessage}</div>
          <div class="chat-message chat-message-assistant">{ai.lastAssistantMessage}</div>
        </div>
          <div if="ai.isLoading" class="chat-preview-messages">
              <div class="chat-message chat-message-user">{ai.lastUserMessage}</div>
              <div class="chat-loading">Thinking<span class="chat-loading-dots"></span></div>
          </div>
      </div>

      <!-- Input area (always visible) -->
      <div class="chat-input-container">
        <div class="chat-input-area">
          <input ref="ai.messageInput" value="{ai.messageInput}" type="text" placeholder="Ask me about whisky..." aria-label="Chat message" />
          <button ref="ai.sendMessage" class="chat-send-btn">→</button>
        </div>
        <div if="ai.hasError" class="chat-error">{ai.errorMessage}</div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
