<html>
  <head>
    <script type="application/jay-headless"
            plugin="@jay-framework/wix-stores-v1"
            contract="category-list"
            key="categoryList"
    ></script>
    <script type="application/jay-headless"
            plugin="@jay-framework/wix-cart"
            contract="cart-indicator"
            key="cartIndicator"
    ></script>
    <script type="application/jay-data">
      data:
    </script>
    <link rel="stylesheet" href="../styles/whisky-theme.css" />
    <style>
      /* ============================================================================
         Homepage Styles - Master of Malt Inspired
         ============================================================================ */

      /* Trust/Benefits Bar */
      .trust-bar {
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border);
        padding: 10px 0;
      }

      .trust-bar-inner {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--page-padding);
        display: flex;
        justify-content: center;
        gap: 48px;
        flex-wrap: wrap;
      }

      .trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-secondary);
      }

      .trust-item-icon {
        font-size: 16px;
      }

      /* Category Cards Row */
      .category-row {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 24px var(--page-padding);
      }

      .category-cards {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 8px;
      }

      .category-cards::-webkit-scrollbar {
        height: 6px;
      }

      .category-cards::-webkit-scrollbar-track {
        background: var(--border-light);
        border-radius: 3px;
      }

      .category-cards::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 3px;
      }

      .category-card {
        position: relative;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: var(--bg-card);
        transition: all var(--transition-base);
        flex: 0 0 200px;
        height: 150px;
        scroll-snap-align: start;
      }

      @media (min-width: 768px) {
        .category-card {
          flex: 0 0 calc((100% - 64px) / 5);
          min-width: 180px;
          height: 140px;
        }
      }

      .category-card:hover {
        box-shadow: var(--shadow-card-hover);
        transform: translateY(-2px);
      }

      .category-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        height: 100%;
        position: relative;
      }

      .category-card-image {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--bg-header) 0%, var(--navy-light) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .category-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
      }

      .category-card:hover .category-card-image img {
        transform: scale(1.05);
      }

      .category-card-image .placeholder-icon {
        font-size: 2.5rem;
        opacity: 0.7;
        color: white;
      }

      .category-card-label {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 10px 14px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
        font-weight: 600;
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Promo Banners Section */
      .promo-section {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--page-padding) 32px;
      }

      .promo-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      @media (max-width: 768px) {
        .promo-grid {
          grid-template-columns: 1fr;
        }
      }

      .promo-banner {
        position: relative;
        border-radius: var(--radius-lg);
        overflow: hidden;
        height: 320px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 32px;
        color: white;
        text-decoration: none;
        transition: transform var(--transition-base);
      }

      .promo-banner:hover {
        transform: translateY(-4px);
        color: white;
      }

      .promo-banner-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .promo-banner-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .promo-banner::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(transparent 30%, rgba(0, 0, 0, 0.7));
        z-index: 1;
      }

      .promo-banner.promo-warm {
        background: linear-gradient(135deg, #8B4513 0%, #654321 50%, #4A3728 100%);
      }

      .promo-banner.promo-dark {
        background: linear-gradient(135deg, #1B2838 0%, #2A3F55 50%, #1B2838 100%);
      }

      .promo-content {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      .promo-title {
        font-family: var(--font-serif);
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 12px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }

      .promo-subtitle {
        font-size: 14px;
        opacity: 0.9;
        margin-bottom: 20px;
        max-width: 280px;
        margin-left: auto;
        margin-right: auto;
      }

      .promo-cta {
        display: inline-block;
        padding: 12px 28px;
        border: 2px solid white;
        border-radius: var(--radius-sm);
        font-weight: 600;
        font-size: 14px;
        transition: all var(--transition-fast);
        text-decoration: none;
        color: white;
      }

      .promo-cta:hover {
        background: white;
        color: var(--text-primary);
      }

      /* Featured Products Section */
      .featured-section {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 32px var(--page-padding);
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }

      .section-title {
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--text-primary);
      }

      .section-link {
        color: var(--navy);
        font-weight: 500;
        font-size: 14px;
      }

      .section-link:hover {
        color: var(--accent);
      }

      /* Empty state */
      .empty-state {
        text-align: center;
        padding: 48px 32px;
        background: var(--bg-card);
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
        max-width: var(--container-max);
        margin: 24px auto;
      }

      .empty-state h3 {
        font-size: 1.1rem;
        margin-bottom: 8px;
        color: var(--text-primary);
      }

      .empty-state p {
        color: var(--text-secondary);
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
    <!-- Site Header -->
    <header class="site-header">
      <div class="header-top">
        <a href="/" class="site-logo">
          WHISKY <span class="logo-accent">store</span>
        </a>
        
        <!-- Search Box -->
        <div class="header-search">
          <div class="header-search-box">
            <input type="text" placeholder="Search..." />
            <button type="button">🔍</button>
          </div>
        </div>
        
        <div class="header-actions">
          <a href="/cart" 
             class="cart-indicator {cartIndicator.hasItems ? has-items} {cartIndicator.isLoading ? is-loading}" 
             ref="cartIndicator.cartLink">
            <span class="cart-indicator-icon">🛒</span>
            <span>Basket</span>
            <span class="cart-indicator-count" if="cartIndicator.hasItems">{cartIndicator.itemCount}</span>
          </a>
        </div>
      </div>
      
      <nav class="main-nav">
        <ul class="nav-links">
          <li><a href="/" class="active">Home</a></li>
          <li><a href="/products">All Products</a></li>
          <li><a href="/products">Whisky</a></li>
          <li><a href="/products">Rum</a></li>
          <li><a href="/products">Gin</a></li>
          <li><a href="/products">Gifts</a></li>
          <li><a href="/products">Special Offers</a></li>
        </ul>
      </nav>
    </header>

    <!-- Trust/Benefits Bar -->
    <div class="trust-bar">
      <div class="trust-bar-inner">
        <div class="trust-item">
          <span class="trust-item-icon">🏪</span>
          <span>Become a Trade customer</span>
        </div>
        <div class="trust-item">
          <span class="trust-item-icon">💬</span>
          <span>Speak to an expert</span>
        </div>
        <div class="trust-item">
          <span class="trust-item-icon">✓</span>
          <span>Price match guarantee</span>
        </div>
        <div class="trust-item">
          <span class="trust-item-icon">🚚</span>
          <span>Express delivery available</span>
        </div>
      </div>
    </div>

    <!-- Category Cards Row -->
    <section class="category-row">
      <div class="category-cards" if="categoryList.hasCategories">
        <article class="category-card" 
                 forEach="categoryList.categories" 
                 trackBy="_id">
          <a href="/categories/{slug}" class="category-card-link" ref="categoryList.categories.categoryLink">
            <div class="category-card-image">
              <img src="{imageUrl}" alt="{name}" if="imageUrl" loading="lazy" />
              <span class="placeholder-icon" if="!imageUrl">🥃</span>
            </div>
            <span class="category-card-label">{name}</span>
          </a>
        </article>
      </div>
    </section>

    <!-- Promotional Banners -->
    <section class="promo-section">
      <div class="promo-grid">
        <a href="/products" class="promo-banner promo-warm">
          <div class="promo-content">
            <h2 class="promo-title">New Arrivals</h2>
            <p class="promo-subtitle">Discover our latest additions to the collection.</p>
            <span class="promo-cta">Explore now</span>
          </div>
        </a>
        <a href="/products" class="promo-banner promo-dark">
          <div class="promo-content">
            <h2 class="promo-title">Top Picks</h2>
            <p class="promo-subtitle">Our experts' favorite selections, handpicked for you.</p>
            <span class="promo-cta">Explore now</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Featured Section with CTA -->
    <section class="featured-section">
      <div class="section-header">
        <h2 class="section-title">Shop by Category</h2>
        <a href="/products" class="section-link">View all products →</a>
      </div>

      <!-- Empty state if no categories -->
      <div class="empty-state" if="!categoryList.hasCategories">
        <h3>No Categories Yet</h3>
        <p>Categories will appear here once they're created.</p>
        <a href="/products" class="btn btn-primary">Browse All Products</a>
      </div>
    </section>
    </div>
  </body>
</html>
