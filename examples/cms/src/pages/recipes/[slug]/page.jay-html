<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{recipe.title} - Recipes</title>
  <script type="application/jay-headless"
          plugin="@jay-framework/wix-data"
          contract="item/recipes-item"
          key="recipe"
  ></script>
  <script type="application/jay-data">
    data:
  </script>
  <link rel="stylesheet" href="../../../styles/cms-theme.css" />
  <style>
    .recipe-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    .breadcrumbs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.875rem;
      color: var(--text-secondary);
      margin-bottom: 24px;
    }

    .breadcrumbs a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumbs a:hover {
      color: var(--accent);
    }

    .breadcrumbs .separator {
      color: var(--border);
    }

    .recipe-header {
      margin-bottom: 32px;
    }

    .recipe-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      line-height: 1.2;
    }

    .recipe-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      color: var(--text-secondary);
      font-size: 1rem;
    }

    .recipe-meta-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .recipe-meta-icon {
      font-size: 1.25rem;
    }

    .recipe-hero-image {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
      border-radius: 16px;
      margin-bottom: 40px;
      background: var(--bg-secondary);
    }

    .recipe-content {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 48px;
    }

    @media (max-width: 768px) {
      .recipe-content {
        grid-template-columns: 1fr;
      }
    }

    .recipe-main {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .recipe-section {
      background: var(--surface);
      border-radius: 12px;
      padding: 24px;
      border: 1px solid var(--border);
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .recipe-description {
      font-size: 1.1rem;
      line-height: 1.7;
      color: var(--text-primary);
    }

    .recipe-steps {
      line-height: 1.8;
      white-space: pre-wrap;
    }

    .recipe-sidebar {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .ingredients-list {
      line-height: 1.8;
      white-space: pre-wrap;
    }

    .category-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--accent-light);
      color: var(--accent);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.875rem;
      font-weight: 500;
      text-decoration: none;
      transition: background 0.2s;
    }

    .category-badge:hover {
      background: var(--accent);
      color: white;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
      margin-top: 40px;
    }

    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="recipe-page">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs">
      <span forEach="recipe.breadcrumbs" trackBy="slug">
        <a href="{url}" ref="recipe.breadcrumbs.link">{title}</a>
        <span class="separator">/</span>
      </span>
      <span>{recipe.title}</span>
    </nav>

    <!-- Recipe Header -->
    <header class="recipe-header">
      <h1 class="recipe-title">{recipe.title}</h1>
      <div class="recipe-meta">
        <span class="recipe-meta-item" if="recipe.preparationTime">
          <span class="recipe-meta-icon">⏱️</span>
          <span>{recipe.preparationTime}</span>
        </span>
        <span class="recipe-meta-item" if="recipe.servings">
          <span class="recipe-meta-icon">👥</span>
          <span>{recipe.servings} servings</span>
        </span>
      </div>
    </header>

    <!-- Hero Image -->
    <img 
      class="recipe-hero-image" 
      src="{recipe.image.url}" 
      alt="{recipe.image.altText}"
      if="recipe.image.url"
    />

    <!-- Content Grid -->
    <div class="recipe-content">
      <!-- Main Content -->
      <div class="recipe-main">
        <!-- Description -->
        <section class="recipe-section" if="recipe.description">
          <h2 class="section-title">📝 About This Recipe</h2>
          <div class="recipe-description">{recipe.description}</div>
        </section>

        <!-- Steps -->
        <section class="recipe-section" if="recipe.steps">
          <h2 class="section-title">👨‍🍳 Instructions</h2>
          <div class="recipe-steps">{recipe.steps}</div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="recipe-sidebar">
        <!-- Category -->
        <section class="recipe-section" if="recipe.category._id">
          <h2 class="section-title">📁 Category</h2>
          <a 
            class="category-badge" 
            ref="recipe.category.categoryLink"
          >
            {recipe.category.title}
          </a>
        </section>

        <!-- Ingredients -->
        <section class="recipe-section" if="recipe.ingredients">
          <h2 class="section-title">🥗 Ingredients</h2>
          <div class="ingredients-list">{recipe.ingredients}</div>
        </section>
      </aside>
    </div>

    <!-- Back Link -->
    <a href="/recipes" class="back-link">
      ← Back to all recipes
    </a>
  </div>
</body>
</html>
