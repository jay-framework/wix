<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CMS Example - Jay Framework</title>
  <meta name="description" content="A demonstration of the Jay Framework's Wix Data plugin, showcasing dynamic content management with auto-generated contracts.">
  <link rel="canonical" href="/"/>
  <script type="application/jay-data">
    data:
  </script>
  <link rel="stylesheet" href="../styles/cms-theme.css" />
  <style>
    .home-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .hero {
      text-align: center;
      margin-bottom: 80px;
    }

    .hero-title {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 20px;
      background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto 32px;
      line-height: 1.6;
    }

    .section-title {
      font-size: 1.75rem;
      font-weight: 700;
      margin-bottom: 32px;
      text-align: center;
    }

    .collections-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 32px;
      margin-bottom: 60px;
    }

    .collection-card {
      background: var(--surface);
      border-radius: 16px;
      padding: 32px;
      border: 1px solid var(--border);
      transition: transform 0.2s, box-shadow 0.2s;
      text-decoration: none;
      color: inherit;
    }

    .collection-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.15);
    }

    .collection-icon {
      font-size: 3rem;
      margin-bottom: 16px;
    }

    .collection-name {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .collection-description {
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 20px;
    }

    .collection-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent);
      font-weight: 500;
    }

    .footer {
      text-align: center;
      padding-top: 40px;
      border-top: 1px solid var(--border);
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    .footer a {
      color: var(--accent);
      text-decoration: none;
    }

    .footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <main class="home-page">
    <!-- Hero Section -->
    <header class="hero">
      <h1 class="hero-title">CMS Example</h1>
      <p class="hero-subtitle">
        A demonstration of the Jay Framework's Wix Data plugin, 
        showcasing dynamic content management with auto-generated contracts.
      </p>
    </header>

    <!-- Collections Section -->
    <section>
      <h2 class="section-title">Browse Collections</h2>
      <div class="collections-grid">
        <!-- Recipes -->
        <a href="/recipes" class="collection-card">
          <div class="collection-icon">🍳</div>
          <h3 class="collection-name">Recipes</h3>
          <p class="collection-description">
            Discover delicious recipes with detailed instructions, 
            ingredients, and preparation times.
          </p>
          <span class="collection-link">
            Browse recipes →
          </span>
        </a>

        <!-- Product Lines -->
        <a href="/food-service-product-lines" class="collection-card">
          <div class="collection-icon">📦</div>
          <h3 class="collection-name">Product Lines</h3>
          <p class="collection-description">
            Explore our food service product lines with detailed 
            information and downloadable resources.
          </p>
          <span class="collection-link">
            View products →
          </span>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p>
        Built with <a href="https://github.com/nicecatchdesigns/jay-framework" target="_blank">Jay Framework</a> 
        and powered by <a href="https://wix.com" target="_blank">Wix Data</a>
      </p>
    </footer>
  </main>
</body>
</html>
