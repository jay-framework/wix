name: RecipesList
description: List page for Recipes
tags:
  - tag: items
    type: sub-contract
    repeated: true
    trackBy: _id
    description: Initial items (rendered server-side)
    tags:
      - {tag: _id, type: data, dataType: string}
      - {tag: url, type: data, dataType: string, description: Full URL to item page}
      - {tag: itemLink, type: interactive, elementType: HTMLAnchorElement}
      - {tag: title, type: data, dataType: string, description: Title}
      - {tag: servings, type: data, dataType: string, description: servings}
      - tag: image
        type: sub-contract
        description: Image
        tags:
        - {tag: url, type: data, dataType: string}
        - {tag: altText, type: data, dataType: string}
        - {tag: width, type: data, dataType: number}
        - {tag: height, type: data, dataType: number}
      - {tag: shortDescription, type: data, dataType: string, description: Short Description}
      - {tag: preparationTime, type: data, dataType: string, description: preparationTime}
  - tag: loadedItems
    type: sub-contract
    repeated: true
    trackBy: _id
    phase: fast+interactive
    description: Additional items loaded on the client
    tags:
      - {tag: _id, type: data, dataType: string}
      - {tag: url, type: data, dataType: string, description: Full URL to item page}
      - {tag: itemLink, type: interactive, elementType: HTMLAnchorElement}
      - {tag: title, type: data, dataType: string, description: Title}
      - {tag: servings, type: data, dataType: string, description: servings}
      - tag: image
        type: sub-contract
        description: Image
        tags:
        - {tag: url, type: data, dataType: string}
        - {tag: altText, type: data, dataType: string}
        - {tag: width, type: data, dataType: number}
        - {tag: height, type: data, dataType: number}
      - {tag: shortDescription, type: data, dataType: string, description: Short Description}
      - {tag: preparationTime, type: data, dataType: string, description: preparationTime}
  - {tag: totalCount, type: data, dataType: number, description: Total items}
  - {tag: hasMore, type: variant, dataType: boolean, phase: fast+interactive, description: More items available}
  - {tag: isLoading, type: variant, dataType: boolean, phase: fast+interactive, description: Loading state}
  - {tag: loadedCount, type: data, dataType: number, phase: fast+interactive, description: Items currently loaded}
  - {tag: loadMoreButton, type: interactive, elementType: HTMLButtonElement, description: Load more trigger}
  - tag: category
    type: sub-contract
    description: Current category
    tags:
    - {tag: _id, type: data, dataType: string}
    - {tag: slug, type: data, dataType: string}
    - {tag: title, type: data, dataType: string}
    - {tag: description, type: data, dataType: string}
    - {tag: categoryLink, type: interactive, elementType: HTMLAnchorElement}
  - tag: breadcrumbs
    type: sub-contract
    repeated: true
    trackBy: slug
    description: Navigation breadcrumbs
    tags:
    - {tag: slug, type: data, dataType: string}
    - {tag: title, type: data, dataType: string}
    - {tag: url, type: data, dataType: string}
    - {tag: link, type: interactive, elementType: HTMLAnchorElement}