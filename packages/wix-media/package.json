{
  "name": "@jay-framework/wix-media",
  "version": "0.19.3",
  "type": "module",
  "description": "Wix Media Manager plugin for Jay Framework — media validation, index generation, and agent-kit references",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin.yaml",
    "agent-kit"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./plugin.yaml": "./plugin.yaml"
  },
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:types && npm run validate",
    "validate": "jay-stack-cli validate-plugin",
    "build:server": "vite build --ssr",
    "build:types": "tsup lib/index.ts --dts-only --format esm",
    "build:check-types": "tsc",
    "clean": "rimraf dist",
    "confirm": "npm run clean && npm run build && npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@jay-framework/compiler-jay-html": "^0.19.3",
    "@jay-framework/compiler-shared": "^0.19.3",
    "@jay-framework/component": "^0.19.3",
    "@jay-framework/fullstack-component": "^0.19.3",
    "@jay-framework/stack-server-runtime": "^0.19.3",
    "@jay-framework/wix-server-client": "workspace:^",
    "@jay-framework/wix-utils": "workspace:^",
    "@wix/media": "^1.0.247",
    "@wix/sdk": "^1.21.5"
  },
  "devDependencies": {
    "@jay-framework/compiler-jay-stack": "^0.19.3",
    "@jay-framework/vite-plugin": "^0.19.3",
    "@types/node": "^20.11.0",
    "node-html-parser": "^6.1.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.0"
  }
}
