{
  "name": "@jay-framework/wix-media",
  "version": "0.24.2",
  "type": "module",
  "description": "Wix Media Manager plugin for Jay Framework — media validation, index generation, and agent-kit references",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin.yaml",
    "agent-kit"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/index.client.js",
    "./plugin.yaml": "./plugin.yaml",
    "./dist/pages/settings/page.jay-html": "./dist/pages/settings/page.jay-html"
  },
  "scripts": {
    "build": "npm run clean && npm run definitions && npm run build:copy-assets && npm run build:client && npm run build:server && npm run build:types && npm run validate",
    "definitions": "jay-cli definitions lib",
    "build:copy-assets": "mkdir -p dist/pages/settings && cp lib/pages/settings/page.jay-html dist/pages/settings/ && cp lib/pages/settings/page.jay-html.d.ts dist/pages/settings/ 2>/dev/null || true",
    "validate": "jay-stack-cli validate-plugin",
    "build:client": "vite build",
    "build:server": "vite build --ssr",
    "build:types": "tsup lib/index.ts lib/index.client.ts --dts-only --format esm",
    "build:check-types": "tsc",
    "clean": "rimraf dist",
    "confirm": "npm run clean && npm run build && npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@jay-framework/compiler-jay-html": "^0.24.2",
    "@jay-framework/compiler-shared": "^0.24.2",
    "@jay-framework/component": "^0.24.2",
    "@jay-framework/fullstack-component": "^0.24.2",
    "@jay-framework/stack-server-runtime": "^0.24.2",
    "@jay-framework/wix-server-client": "workspace:^",
    "@jay-framework/wix-utils": "workspace:^",
    "@wix/media": "^1.0.247",
    "@wix/sdk": "^1.21.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@jay-framework/compiler-jay-stack": "^0.24.2",
    "@jay-framework/jay-stack-cli": "^0.24.2",
    "@jay-framework/vite-plugin": "^0.24.2",
    "@types/node": "^20.11.0",
    "node-html-parser": "^6.1.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.0"
  }
}
