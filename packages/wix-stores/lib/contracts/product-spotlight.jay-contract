name: product-spotlight
description: A single product card by slug. Use to feature a specific product on any page (homepage, content pages, etc.).
props:
  - name: slug
    type: string
    description: Product slug to display
tags:
  - tag: product
    type: sub-contract
    repeated: true
    trackBy: _id
    phase: fast+interactive
    description: The product card (single-element list for consistent card rendering)
    link: ./product-card

  - tag: hasProduct
    type: variant
    dataType: boolean
    phase: fast+interactive
    description: Whether the product was found
