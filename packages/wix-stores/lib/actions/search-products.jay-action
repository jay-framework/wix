name: searchProducts
description: Search products in the Wix Store catalog using Catalog V3. Supports text search, price/stock/category filtering, sorting, and cursor-based pagination. Returns matching products with price aggregation data.

import:
  productCard: product-card.jay-contract

inputSchema:
  query: string
  filters?:
    inStockOnly?: boolean
    minPrice?: number
    maxPrice?: number
    categoryIds?: string[]
    optionFilters?:
      - optionName: string
        choiceNames: string[]
  sortBy?: enum(relevance | price_asc | price_desc | name_asc | name_desc | newest)
  cursor?: string
  pageSize?: number

outputSchema:
  products:
    - productCard
  totalCount: number
  nextCursor?: string
  hasMore: boolean
  priceAggregation?:
    minBound: number
    maxBound: number
    ranges:
      - rangeId: string
        label: string
        minValue?: number
        maxValue?: number
        productCount: number
        isSelected: boolean
  optionFilters?:
    - optionId: string
      optionName: string
      optionRenderType: enum(TEXT_CHOICES | SWATCH_CHOICES)
      choices:
        - choiceId: string
          choiceName: string
          colorCode: string
          productCount: number
  categoryCounts?:
    - categoryId: string
      productCount: number
