name: getFormSummary
description: >-
  Deprecated since DL #51: wix-bookings reads its participant form with wixBookings.getParticipantForm.
  Loads flat form field summaries; fields this version cannot show are listed in unsupportedFields.

inputSchema:
  formId?: string

outputSchema:
  fields:
    - target: string
      label: string
      type: enum(STRING | EMAIL | PHONE | NUMBER | URL)
      required: boolean
  unsupportedFields:
    - target: string
      label: string
      wixKind: string
      # Always "unknown": the Form Summary API carries no required flag (DL #51 Q13).
      required: string
