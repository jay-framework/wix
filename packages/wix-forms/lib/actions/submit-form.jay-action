name: submitForm
description: Submit a Wix Form with field values keyed by target.

inputSchema:
  formId?: string
  values: object
  honeypot?: string  # value of the page's honeypot, for direct posts; the plugin component never sends it (DL#53)
  fromHook?: boolean  # true when fieldErrors come from the submit hook's FieldRejection (DL#57)

outputSchema:
  success: boolean
  redirectTo?: string
  message?: string
  fieldErrors?: object  # by target, or <target>/<part> for an address part (DL #52)
  fieldOptions?: object  # <target>/subdivision → the codes Wix accepts, learned from this 400 (DL #52)
  revealedParts?: object  # target → parts Wix required that the layout hid (DL #52)
  factsCountry?: object  # target → the submitted country the learned facts belong to (DL #52)
  fieldRules?: object  # target → FieldRule index (REQUIRED=1, …) for server field errors the plugin classifies; others are SERVER (DL#55)
  reason?: number  # SubmitFailure enum index when success is false (NONE=0, VALIDATION=1, …); locale-neutral outcome for pages
  code?: string  # the hook's ActionError / FieldRejection code; absent for plugin and Wix failures (DL#53)
