<form novalidate>
    <fieldset>
        <label>{contact.address.country.label}<select ref="contact.address.country.input" autocomplete="country"></select></label>
        <label>{contact.address.streetName.label}<input ref="contact.address.streetName.input" autocomplete="address-line1" /></label>
        <label>{contact.address.streetNumber.label}<input ref="contact.address.streetNumber.input" /></label>
        <label>{contact.address.addressLine.label}<input ref="contact.address.addressLine.input" autocomplete="address-line1" /></label>
        <label>{contact.address.addressLine2.label}<input ref="contact.address.addressLine2.input" autocomplete="address-line2" /></label>
        <label>{contact.address.city.label}<input ref="contact.address.city.input" autocomplete="address-level2" /></label>
        <label>{contact.address.subdivision.label}<select ref="contact.address.subdivision.input" autocomplete="address-level1"></select><input ref="contact.address.subdivision.text" autocomplete="address-level1" /></label>
        <label>{contact.address.postalCode.label}<input ref="contact.address.postalCode.input" autocomplete="postal-code" /></label>
    </fieldset>
    <button ref="contact.submitButton">Send</button>
</form>
