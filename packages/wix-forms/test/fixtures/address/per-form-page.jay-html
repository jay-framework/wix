<html>
<head>
  <script type="application/jay-data">
data:
  </script>
  <script type="application/jay-headless" contract="./generated.jay-contract" key="contact"></script>
</head>
<body>
<form novalidate>
<fieldset>
  <label
    >{contact.address.country.label}
    <select ref="contact.address.country.input" autocomplete="country">
      <option forEach="contact.address.country.options" trackBy="value" value="{value}">{label}</option>
    </select></label
  >
  <label if="contact.address.streetName.shown"
    >{contact.address.streetName.label}<input ref="contact.address.streetName.input"
  /></label>
  <label if="contact.address.streetNumber.shown"
    >{contact.address.streetNumber.label}<input ref="contact.address.streetNumber.input"
  /></label>
  <label if="contact.address.addressLine.shown"
    >{contact.address.addressLine.label}<input ref="contact.address.addressLine.input" autocomplete="address-line1"
  /></label>
  <label if="contact.address.addressLine2.shown"
    >{contact.address.addressLine2.label}<input ref="contact.address.addressLine2.input" autocomplete="address-line2"
  /></label>
  <label if="contact.address.city.shown"
    >{contact.address.city.label}<input ref="contact.address.city.input" autocomplete="address-level2"
  /></label>
  <label if="contact.address.subdivision.shown"
    >{contact.address.subdivision.label}
    <select if="contact.address.subdivision.listed" ref="contact.address.subdivision.input" autocomplete="address-level1">
      <option forEach="contact.address.subdivision.options" trackBy="value" value="{value}">{label}</option>
    </select>
    <input if="!contact.address.subdivision.listed" ref="contact.address.subdivision.text" autocomplete="address-level1"
  /></label>
  <label if="contact.address.postalCode.shown"
    >{contact.address.postalCode.label}<input ref="contact.address.postalCode.input" autocomplete="postal-code"
  /></label>
</fieldset>
  <p if="contact.address.invalid">{contact.address.error}</p>
  <button type="submit" ref="contact.submitButton">Send</button>
</form>
</body>
</html>
