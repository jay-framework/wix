name: searchProducts
description: Search products using Wix Stores Catalog V1 with page-based pagination. Supports text search, price and collection filtering, sorting, and returns price aggregation data.

import:
  productCard: product-card.jay-contract

inputSchema:
  query: string
  filters?:
    minPrice?: number
    maxPrice?: number
    collectionIds?: string[]
  sortBy?: enum(relevance | price_asc | price_desc | name_asc | name_desc | newest)
  page?: number
  pageSize?: number

outputSchema:
  products:
    - productCard
  totalCount: number
  currentPage: number
  totalPages: number
  hasMore: boolean
  priceAggregation:
    minBound: number
    maxBound: number
    ranges:
      - rangeId: string
        label: string
        minValue?: number
        maxValue?: number
        isSelected: boolean
