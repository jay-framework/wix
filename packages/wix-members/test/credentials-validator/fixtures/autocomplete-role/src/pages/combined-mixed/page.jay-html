<html>
  <head>
  </head>
  <body>
    <form ref="form">
      <input ref="email" type="email" autocomplete="username" />
      <input ref="password" type="password" autocomplete="current-password" />
      <button type="submit">Log in</button>
    </form>
    <form ref="signupForm">
      <input ref="signupEmail" type="email" autocomplete="username" />
      <input ref="newPassword" type="password" autocomplete="new-password" />
      <input ref="confirmPassword" type="password" autocomplete="current-password" />
      <button type="submit">Sign up</button>
    </form>
  </body>
</html>
