{
  "name": "@jay-framework/wix-data",
  "version": "0.15.3",
  "type": "module",
  "description": "Wix Data plugin for Jay Framework with dynamic contract generation",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin.yaml"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/index.client.js",
    "./plugin.yaml": "./plugin.yaml",
    "./query-items.jay-action": "./dist/actions/query-items.jay-action",
    "./get-item-by-slug.jay-action": "./dist/actions/get-item-by-slug.jay-action",
    "./get-categories.jay-action": "./dist/actions/get-categories.jay-action"
  },
  "scripts": {
    "build": "npm run clean && npm run definitions && npm run build:client && npm run build:server && npm run build:copy-actions && npm run build:types",
    "definitions": "jay-cli definitions lib/actions",
    "build:copy-actions": "mkdir -p dist/actions && cp lib/actions/*.jay-action dist/actions/",
    "build:client": "vite build",
    "build:server": "vite build --ssr",
    "build:types": "tsup lib/index.ts --dts-only --format esm",
    "build:check-types": "tsc",
    "clean": "rimraf dist",
    "confirm": "npm run clean && npm run build && npm run test",
    "test": ":"
  },
  "dependencies": {
    "@jay-framework/component": "^0.15.3",
    "@jay-framework/fullstack-component": "^0.15.3",
    "@jay-framework/reactive": "^0.15.3",
    "@jay-framework/runtime": "^0.15.3",
    "@jay-framework/secure": "^0.15.3",
    "@jay-framework/stack-client-runtime": "^0.15.3",
    "@jay-framework/stack-server-runtime": "^0.15.3",
    "@jay-framework/wix-server-client": "workspace:^",
    "@jay-framework/wix-utils": "workspace:^",
    "@wix/data": "^1.0.427",
    "@wix/sdk": "^1.21.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "@babel/preset-typescript": "^7.23.3",
    "@jay-framework/compiler-jay-stack": "^0.15.3",
    "@jay-framework/jay-cli": "^0.15.3",
    "@jay-framework/vite-plugin": "^0.15.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.3",
    "rimraf": "^5.0.5",
    "tslib": "^2.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-inspect": "^0.8.1"
  }
}
