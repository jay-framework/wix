name: queryItems
description: Query items from a Wix Data collection with pagination, sorting, and filtering. Returns matching items with total count.

inputSchema:
  collectionId: string
  limit?: number
  offset?: number
  sortField?: string
  sortDirection?: enum(ASC | DESC)
  filter?: {}
  categoryId?: string
  categoryField?: string

outputSchema:
  items:
    - {}
  totalCount: number
  offset: number
  hasMore: boolean
