{
  "name": "@jay-framework/wix-deploy",
  "version": "0.24.2",
  "type": "module",
  "description": "Wix BaaS deployment adapter for Jay Framework — WixDataArtifactStore and entry builder",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin.yaml",
    "agent-kit"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./artifact-store": "./dist/artifact-store.js",
    "./plugin.yaml": "./plugin.yaml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:types && npm run validate",
    "validate": "jay-stack-cli validate-plugin",
    "build:server": "vite build --ssr",
    "build:types": "tsup lib/index.ts --dts-only --format esm",
    "build:check-types": "tsc",
    "clean": "rimraf dist",
    "confirm": "npm run clean && npm run build && npm run test",
    "test": ":"
  },
  "dependencies": {
    "@jay-framework/compiler-jay-html": "^0.24.2",
    "@jay-framework/compiler-shared": "^0.24.2",
    "@jay-framework/fullstack-component": "^0.24.2",
    "@jay-framework/production-server": "^0.24.2",
    "@jay-framework/stack-server-runtime": "^0.24.2",
    "@jay-framework/wix-server-client": "workspace:^",
    "@wix/data": "^1.0.433",
    "@wix/sdk": "^1.21.5",
    "esbuild": "^0.21.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@jay-framework/jay-stack-cli": "^0.24.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
