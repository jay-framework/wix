name: booking-flow
description: Browse Wix Bookings services, select a slot, submit participant details, and complete checkout.

tags:
  - tag: services
    type: sub-contract
    repeated: true
    trackBy: id
    phase: fast+interactive
    description: Available services
    tags:
      - { tag: id, type: data, dataType: string }
      - { tag: name, type: data, dataType: string }
      - { tag: description, type: data, dataType: string }
      - { tag: type, type: data, dataType: string }
      - { tag: durationLabel, type: data, dataType: string }
      - { tag: priceLabel, type: data, dataType: string }
      - { tag: formId, type: data, dataType: string }
      - { tag: serviceButtons, type: interactive, elementType: HTMLButtonElement, description: Select a service }

  - tag: servicesLoading
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: showNoServices
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: hasSlots
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: servicesError
    type: data
    dataType: string
    phase: fast+interactive
    description: English default text; branch on servicesFailure for your own copy

  - tag: servicesFailure
    type: variant
    dataType: enum (NONE | PERMISSION | UNKNOWN)
    phase: fast+interactive
    description: Why listing services failed (NONE when it did not)

  - tag: showServices
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: showSlots
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: showForm
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: selectedServiceName
    type: data
    dataType: string
    phase: fast+interactive

  - tag: slots
    type: sub-contract
    repeated: true
    trackBy: id
    phase: fast+interactive
    tags:
      - { tag: id, type: data, dataType: string }
      - { tag: label, type: data, dataType: string }
      - { tag: localStartDate, type: data, dataType: string }
      - { tag: localEndDate, type: data, dataType: string }
      - { tag: scheduleId, type: data, dataType: string }
      - { tag: eventId, type: data, dataType: string }
      - { tag: slotButtons, type: interactive, elementType: HTMLButtonElement, description: Select a time slot }

  - tag: slotsLoading
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: slotsMessage
    type: data
    dataType: string
    phase: fast+interactive
    description: English default text (a load error, or no available times)

  - tag: slotsFailure
    type: variant
    dataType: enum (NONE | UNKNOWN)
    phase: fast+interactive
    description: Whether loading availability failed; no times with NONE means none are available

  - tag: formFields
    type: sub-contract
    repeated: true
    trackBy: target
    phase: fast+interactive
    tags:
      - { tag: target, type: data, dataType: string }
      - { tag: label, type: data, dataType: string }
      - { tag: type, type: data, dataType: string, description: "STRING | EMAIL | PHONE | URL | BOOLEAN (a single checkbox: bind it to an input type=checkbox). The address is not here: bind the address tag" }
      - { tag: required, type: data, dataType: boolean }
      - { tag: formInputs, type: interactive, elementType: HTMLInputElement, description: Participant form field (a checkbox for BOOLEAN) }

  - tag: address
    type: sub-contract
    phase: fast+interactive
    description: "The participant address (DL #52); bind every part, each country shows its own."
    tags:
      - { tag: present, type: variant, dataType: boolean, description: The participant form has an address field }
      - { tag: label, type: data, dataType: string }
      - { tag: required, type: variant, dataType: boolean }
      - { tag: error, type: data, dataType: string }
      - { tag: invalid, type: variant, dataType: boolean }
      - tag: country
        type: sub-contract
        tags:
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: input, type: interactive, elementType: HTMLSelectElement }
          - tag: options
            type: sub-contract
            repeated: true
            trackBy: value
            tags:
              - { tag: value, type: data, dataType: string }
              - { tag: label, type: data, dataType: string }
      - tag: addressLine
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: maxLength, type: data, dataType: number }
          - { tag: input, type: interactive, elementType: HTMLInputElement }
      - tag: addressLine2
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: maxLength, type: data, dataType: number }
          - { tag: input, type: interactive, elementType: HTMLInputElement }
      - tag: streetName
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: maxLength, type: data, dataType: number }
          - { tag: input, type: interactive, elementType: HTMLInputElement }
      - tag: streetNumber
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: maxLength, type: data, dataType: number }
          - { tag: input, type: interactive, elementType: HTMLInputElement }
      - tag: city
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: maxLength, type: data, dataType: number }
          - { tag: input, type: interactive, elementType: HTMLInputElement }
      - tag: subdivision
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: listed, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: input, type: interactive, elementType: HTMLSelectElement }
          - { tag: text, type: interactive, elementType: HTMLInputElement }
          - tag: options
            type: sub-contract
            repeated: true
            trackBy: value
            tags:
              - { tag: value, type: data, dataType: string }
              - { tag: label, type: data, dataType: string }
      - tag: postalCode
        type: sub-contract
        tags:
          - { tag: shown, type: variant, dataType: boolean }
          - { tag: required, type: variant, dataType: boolean }
          - { tag: label, type: data, dataType: string }
          - { tag: value, type: data, dataType: string }
          - { tag: error, type: data, dataType: string }
          - { tag: invalid, type: variant, dataType: boolean }
          - { tag: maxLength, type: data, dataType: number }
          - { tag: input, type: interactive, elementType: HTMLInputElement }

  - tag: formLoading
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: isBooking
    type: variant
    dataType: boolean
    phase: fast+interactive

  - tag: bookingStatus
    type: data
    dataType: string
    phase: fast+interactive
    description: English default text on confirmation; branch on bookingState for your own copy

  - tag: bookingError
    type: data
    dataType: string
    phase: fast+interactive
    description: English default text on failure; branch on bookingFailure for your own copy

  - tag: bookingState
    type: variant
    dataType: enum (IDLE | BOOKING | CONFIRMED | FAILED)
    phase: fast+interactive

  - tag: bookingFailure
    type: variant
    dataType: enum (NONE | VALIDATION | FORM_UNAVAILABLE | CHECKOUT_PERMISSION | CHECKOUT_REDIRECT_REJECTED | SITE_NOT_PUBLISHED | UNKNOWN | FORM_UNSUPPORTED)
    phase: fast+interactive
    description: Why the participant form or the booking failed (NONE when it did not). FORM_UNSUPPORTED = the form has a required field this site cannot show; booking stays off until the site is updated

  - tag: bookButton
    type: interactive
    elementType: HTMLButtonElement
    description: Confirm booking

  - tag: backButton
    type: interactive
    elementType: HTMLButtonElement
    description: Back to service list
