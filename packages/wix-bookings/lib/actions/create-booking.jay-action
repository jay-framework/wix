name: createBooking
description: >-
  Re-validate the participant values against the service's form, then create a booking and complete
  free checkout or return a paid checkout redirect URL. Form problems are returned as outcomes:
  invalid (fieldErrors by field target) or formUnavailable (FORM_UNSUPPORTED never succeeds on retry).

inputSchema:
  serviceId: string
  serviceType: enum(APPOINTMENT | CLASS)
  slot:
    localStartDate: string
    localEndDate: string
    scheduleId?: string
    eventId?: string
  formValues: object
  timezone: string
  siteOrigin: string
  paymentPreference?: enum(ONLINE | OFFLINE)

outputSchema:
  outcome: enum(confirmed | redirect | invalid | formUnavailable)
  orderId?: string
  redirectUrl?: string
  fieldErrors?: object  # by target, or <target>/<part> for an address part (DL #52)
  fieldOptions?: object  # <target>/subdivision → the codes Wix accepts, learned from this 400 (DL #52)
  revealedParts?: object  # target → parts Wix required that the layout hid (DL #52)
  factsCountry?: object  # target → the submitted country the learned facts belong to (DL #52)
  failure?: enum(FORM_UNSUPPORTED | FORM_UNAVAILABLE)
  message?: string
